ENV=development
# Supabase "Connection string" (URI). postgresql:// is rewritten to postgresql+psycopg://
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apartment_planner
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
OWNER_EMAIL=you@example.com
# Local development only; refused when ENV=production
AUTH_DISABLED=false
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200
# Document storage: "supabase" (required when ENV=production) or "local" (disk, dev/tests)
STORAGE_BACKEND=local
STORAGE_BUCKET=documents
STORAGE_LOCAL_DIR=.devdata/files
# Browser-visible base URL of this API (used to build local upload/download URLs)
API_PUBLIC_URL=http://localhost:8000
# Server-side only. Never expose to the frontend. Needed when STORAGE_BACKEND=supabase.
SUPABASE_SERVICE_ROLE_KEY=
